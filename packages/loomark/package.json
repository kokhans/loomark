{
  "name": "loomark",
  "version": "0.1.0",
  "description": "Loomark is a build-time data library for Next.js 16, React Router v8 and TanStack Start that compiles Markdown collections into searchable, filterable, sortable and SEO-friendly content for blogs and docs.",
  "author": "Serhii Kokhan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kokhans/loomark.git",
    "directory": "packages/loomark"
  },
  "homepage": "https://github.com/kokhans/loomark/tree/main/packages/loomark#readme",
  "bugs": {
    "url": "https://github.com/kokhans/loomark/issues"
  },
  "keywords": [
    "markdown",
    "frontmatter",
    "content",
    "react",
    "nextjs",
    "react-router",
    "tanstack-start",
    "vite",
    "static-site",
    "search",
    "sitemap",
    "rss"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "loomark": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./query": {
      "types": "./dist/query.d.ts",
      "import": "./dist/query.js",
      "default": "./dist/query.js"
    },
    "./search": {
      "types": "./dist/search.d.ts",
      "import": "./dist/search.js",
      "default": "./dist/search.js"
    },
    "./mermaid": {
      "types": "./dist/mermaid.d.ts",
      "import": "./dist/mermaid.js",
      "default": "./dist/mermaid.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js",
      "default": "./dist/next.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "default": "./dist/vite.js"
    },
    "./seo": {
      "types": "./dist/seo.d.ts",
      "import": "./dist/seo.js",
      "default": "./dist/seo.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "jiti": "^2.7.0",
    "minisearch": "^7.2.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.6.0",
    "unified": "^11.0.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "mermaid": ">=11"
  },
  "peerDependenciesMeta": {
    "mermaid": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/hast": "^3.0.5",
    "@types/node": "^26.6.6",
    "mermaid": "^12.3.0",
    "tsdown": "^0.23.7",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
